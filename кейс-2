from datetime import datetime

# Ввод данных
day = int(input("Введите день рождения: "))
month = int(input("Введите месяц рождения: "))
year = int(input("Введите год рождения: "))

# Функция для определения дня недели
def get_weekday(day, month, year):
    return datetime(year, month, day).strftime("%A")

# Функция для проверки високосного года
def is_leap_year(year):
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

# Функция для вычисления возраста
def calculate_age(day, month, year):
    today = datetime.now()
    age = today.year - year - ((today.month, today.day) < (month, day))
    return age

# Вывод даты в формате "** ** ****"
def draw_digital_date(day, month, year):
    digit_map = {
        '0': ['***', '* *', '* *', '* *', '***'],
        # ... (остальные цифры)
    }
    date_str = f"{day:02d} {month:02d} {year}"
    for line in range(5):
        for char in date_str:
            print(digit_map.get(char, ['   '])[line], end=' ')
        print()

# Вывод результатов
print(f"День недели: {get_weekday(day, month, year)}")
print(f"Високосный год: {'Да' if is_leap_year(year) else 'Нет'}")
print(f"Возраст: {calculate_age(day, month, year)} лет")
print(f"Дата рождения в формате: {draw_digital_date(day, month, year)}")

